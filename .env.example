# Copie este arquivo para `.env` e preencha. O `.env` não vai para o git.

# --- Azure DevOps (obrigatório) ----------------------------------------------
# Organização: o "{org}" de https://dev.azure.com/{org}
ADO_ORG=
# Nome do projeto exatamente como aparece no ADO (pode conter espaços)
ADO_PROJECT=
# Personal Access Token, só com escopos de leitura:
#   Work Items (Read), Project and Team (Read), Analytics (Read), Wiki (Read)
ADO_PAT=

# --- Opcionais (os valores abaixo são os padrões) ----------------------------
ADO_API_VERSION=7.1
ADO_ANALYTICS_VERSION=v4.0-preview
OUT_DIR=out
LOG_DIR=logs
MAX_WORKERS=6
# A API de batch do ADO recusa mais de 200 ids por chamada.
BATCH_SIZE=200
CONNECT_TIMEOUT_S=10
READ_TIMEOUT_S=180
MAX_RETRIES=5
# utf-8-sig grava BOM: abre corretamente no Excel no Windows.
CSV_ENCODING=utf-8-sig
LOG_LEVEL=INFO

# --- OpenAI: textos do painel -------------------------------------------------
# Sem OPENAI_MODEL, o painel sai sem textos de LLM. Sem OPENAI_API_KEY (ou com
# `radar relatorio --sem-llm`), só reaproveita os textos já gravados.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_S=30
